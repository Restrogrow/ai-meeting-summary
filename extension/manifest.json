{
  "manifest_version": 3,
  "name": "Meeting Notes",
  "version": "1.2.0",
  "description": "Record a Google Meet tab (screen + audio) and get AI meeting summaries — right from the toolbar.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Meeting Notes",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["tabCapture", "offscreen", "storage", "downloads", "notifications", "activeTab", "unlimitedStorage"],
  "host_permissions": [
    "https://ai-meeting-summary-five.vercel.app/*",
    "https://generativelanguage.googleapis.com/*",
    "http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "commands": {
    "toggle-recording": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Start / stop recording the current tab"
    }
  }
}
